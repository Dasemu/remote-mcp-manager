# Port the manager's own HTTP server listens on (the operator's own nginx proxies to this)
PORT=3000

# Path to the Docker/Podman-API-compatible socket.
# Production (Docker): /var/run/docker.sock
# Local dev (rootless Podman): /run/user/<uid>/podman/podman.sock
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Name of the shared container network joining the manager and every installed MCP container
MCP_NETWORK_NAME=mcp-net

# Where the manager stores its SQLite DB, cloned repos and build logs
DATA_DIR=./data

# Public base URL used to build the authenticated MCP links shown in the UI, e.g. https://mcp.example.com
PUBLIC_BASE_URL=http://localhost:3000

# Password for the single admin/operator account that can use the panel
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie
SESSION_SECRET=change-me-too

# Random string (min 32 chars) used to derive the AES-256-GCM key that encrypts
# installation env vars and bearer tokens at rest
MASTER_KEY=change-me-to-a-random-string-of-at-least-32-characters

# Resource caps applied to every installed MCP container (same limit for all, no per-installation
# override in V1). Set either to 0 to disable that cap — needed on hosts that can't enforce cgroup
# limits for nested containers (e.g. an unprivileged, OpenRC-based LXC with no systemd to delegate
# cgroup controllers; `docker run` fails outright there if a limit is requested).
CONTAINER_MEMORY_MB=512
CONTAINER_CPUS=1

# Safeguards against a stuck upstream or a memory leak taking the host down (see docs/operations.md).
# Inactivity timeout (ms) on proxied MCP requests/streams
PROXY_TIMEOUT_MS=300000
# Max simultaneous proxied requests; beyond this the proxy answers 503
MAX_PROXY_REQUESTS=100
# The manager exits (and is restarted by compose) when its heap + external memory passes this. 0 disables.
MANAGER_MEMORY_LIMIT_MB=512

# Enables the panel's "Update manager" button: the manager clones this repo at SELF_UPDATE_REF,
# builds a new image and replaces its own container (rolls back if the new one isn't healthy).
# Operator-set only, never taken from a request. Leave empty to disable the button.
# Needs SSH_DIR below if the URL is ssh://. See docs/operations.md.
SELF_UPDATE_REPO_URL=
SELF_UPDATE_REF=master
# Optional, read by docker compose at build time only (not by the app): the commit being built,
# e.g. GIT_SHA=$(git rev-parse HEAD) docker compose up -d --build
# GIT_SHA=

# Absolute path to an SSH dir (key + known_hosts) with clone access to the repos you'll
# install, mounted read-only into the manager container so `git clone ssh://...` works for
# private repos. Required only if you install from private/SSH repo URLs.
SSH_DIR=/root/.ssh
